# Copiá este archivo a server/.env y completá los valores reales.

# Conexión a tu MongoDB local (el que administrás con MongoDB Compass).
# Compass, por defecto, apunta a mongodb://localhost:27017 — solo hay
# que agregarle el nombre de la base al final.
MONGODB_URI=mongodb://127.0.0.1:27017/clinica-orofacial

# String largo y aleatorio, solo para firmar los tokens de sesión del admin.
JWT_SECRET=cambiar-por-un-string-largo-y-aleatorio

PORT=4000
NODE_ENV=development

# URL del frontend (Vite): único origen habilitado por CORS y base de las
# URLs de retorno de Mercado Pago.
CLIENT_URL=http://localhost:5173

# Credenciales del único usuario admin. Se usan solo al correr el seed
# (server/scripts/seed.js) — en la base solo queda guardado el hash de
# la contraseña, nunca el texto plano.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-por-una-contraseña-segura

# Mercado Pago (Checkout Pro). Access Token de la aplicación — en modo
# prueba, usar el de las credenciales de prueba. Nunca va en el frontend.
MP_ACCESS_TOKEN=

# Emails automáticos (aviso de nuevo pedido y confirmación al comprador),
# enviados con la API de Brevo. GMAIL_USER es el remitente de todos los
# correos y quien recibe el aviso; tiene que estar verificado como
# remitente en Brevo (Senders & IP). BREVO_API_KEY: Brevo → SMTP & API → API Keys.
GMAIL_USER=
BREVO_API_KEY=

# Cloudinary, donde se guardan las imágenes que se suben desde el admin
# (Dashboard de Cloudinary → API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
